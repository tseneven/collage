<Page x:Class="prakt15.pages.AddAndEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:prakt15.pages"
      mc:Ignorable="d" 
      Background="#dfeaeb"
      xmlns:validators="clr-namespace:prakt15.validation"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      d:DesignHeight="450" d:DesignWidth="800"
      DataContext="{Binding RelativeSource={RelativeSource Self}}"
      Title="AddAndEditPage" Loaded="Page_Loaded">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="1">
            <TextBlock x:Name="Label" TextAlignment="Center" FontWeight="DemiBold" FontSize="20">Добавить</TextBlock>
            <TextBox x:Name="Title" Background ="#00C4B4" materialDesign:HintAssist.Hint="Название">
                <TextBox.Style>
                    <Style TargetType="TextBox"
               BasedOn="{StaticResource MaterialDesignTextBox}">
                        <Setter Property="Margin" Value="0 5"/>
                        <Style.Triggers>
                            <Trigger Property="Validation.HasError" Value="True">
                                <Setter Property="BorderBrush" Value="Red"/>
                                <Setter Property="BorderThickness" Value="2"/>
                                <Setter Property="Margin" Value="0 10"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
                <TextBox.Text>
                    <Binding Path="product.Name" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <validators:FieldValidator/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>
            <TextBox x:Name="Desc" Background ="#00C4B4" materialDesign:HintAssist.Hint="Описание">
                <TextBox.Style>
                    <Style TargetType="TextBox"
               BasedOn="{StaticResource MaterialDesignTextBox}">
                        <Setter Property="Margin" Value="0 5"/>
                        <Style.Triggers>
                            <Trigger Property="Validation.HasError" Value="True">
                                <Setter Property="BorderBrush" Value="Red"/>
                                <Setter Property="BorderThickness" Value="2"/>
                                <Setter Property="Margin" Value="0 10"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
                <TextBox.Text>
                    <Binding Path="product.Description" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <validators:FieldValidator/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>
            <TextBox x:Name="Price" Background ="#00C4B4" materialDesign:HintAssist.Hint="Цена">
                <TextBox.Style>
                    <Style TargetType="TextBox"
               BasedOn="{StaticResource MaterialDesignTextBox}">
                        <Setter Property="Margin" Value="0 5"/>
                        <Style.Triggers>
                            <Trigger Property="Validation.HasError" Value="True">
                                <Setter Property="BorderBrush" Value="Red"/>
                                <Setter Property="BorderThickness" Value="2"/>
                                <Setter Property="Margin" Value="0 10"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
                <TextBox.Text>
                    <Binding Path="product.Price" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <validators:FieldValidator/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>
            <TextBox x:Name="Stock" Background ="#00C4B4" materialDesign:HintAssist.Hint="Остаток">
                <TextBox.Style>
                    <Style TargetType="TextBox"
               BasedOn="{StaticResource MaterialDesignTextBox}">
                        <Setter Property="Margin" Value="0 5"/>
                        <Style.Triggers>
                            <Trigger Property="Validation.HasError" Value="True">
                                <Setter Property="BorderBrush" Value="Red"/>
                                <Setter Property="BorderThickness" Value="2"/>
                                <Setter Property="Margin" Value="0 10"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
                <TextBox.Text>
                    <Binding Path="product.Stock" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <validators:FieldValidator/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>
            <TextBox x:Name="RatingCB" Background="#00C4B4" materialDesign:HintAssist.Hint="Рейтинг">
                <TextBox.Style>
                    <Style TargetType="TextBox"
               BasedOn="{StaticResource MaterialDesignTextBox}">
                        <Setter Property="Margin" Value="0 5"/>
                        <Style.Triggers>
                            <Trigger Property="Validation.HasError" Value="True">
                                <Setter Property="BorderBrush" Value="Red"/>
                                <Setter Property="BorderThickness" Value="2"/>
                                <Setter Property="Margin" Value="0 10"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
                <TextBox.Text>
                    <Binding Path="product.Rating" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <validators:FieldValidator/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>
            <ComboBox Background="#00C4B4" materialDesign:HintAssist.Hint="Бренд" Margin="0 5" DisplayMemberPath="Name" SelectedItem="{Binding product.Brand, Mode=TwoWay}" ItemsSource="{Binding brandService.Brands}"></ComboBox>
            <ComboBox Background="#00C4B4" materialDesign:HintAssist.Hint="Категория" Margin="0 5" DisplayMemberPath="Name" ItemsSource="{Binding categoriesSeivice.Categories}" SelectedItem="{Binding product.Categories, Mode=TwoWay}"></ComboBox>
            <Button x:Name="Add" Background="#00C4B4" Click="Add_Click" Content="Добавить">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=Title, Path=(Validation.HasError)}" Value="true">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ElementName=Desc, Path=(Validation.HasError)}" Value="true">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ElementName=Price, Path=(Validation.HasError)}" Value="true">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ElementName=Stock, Path=(Validation.HasError)}" Value="true">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ElementName=RatingCB, Path=(Validation.HasError)}" Value="true">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button x:Name="Back" Background="#00C4B4" Click="Back_Click">Назад</Button>
        </StackPanel>
    </Grid>
</Page>
