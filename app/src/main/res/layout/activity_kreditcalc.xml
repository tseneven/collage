<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    tools:context=".CreditCalcActivity"
    android:background="@color/green">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="171dp"
        android:background="@color/white"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/arrow"
                android:layout_marginTop="15dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/back"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginTop="5dp"/>
        </LinearLayout>


        <TextView
            android:layout_width="375dp"
            android:layout_height="wrap_content"
            android:text="@string/creditCalc"
            android:textColor="@color/black"
            android:textSize="24dp"
            android:textStyle="bold"
            android:layout_marginLeft="50dp"
            android:layout_marginTop="30dp"/>
    </LinearLayout>
    
    <LinearLayout
        android:layout_width="350dp"
        android:layout_height="70dp"
        android:background="@drawable/seekstyle"
        android:orientation="vertical"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="72dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/need"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="10dp"/>
        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="340dp"
            android:layout_height="wrap_content"
            android:min="30000"
            android:max="100000"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                >
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/three"
                    android:layout_marginLeft="10dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hun"
                    android:layout_marginLeft="194dp"/>
            </LinearLayout>
    </LinearLayout>
    
    <LinearLayout
        android:layout_width="160dp"
        android:layout_height="60dp"
        android:orientation="vertical"
        android:background="@drawable/srock"
        android:layout_marginTop="20dp"
        android:layout_marginLeft="100dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/srock"
            android:layout_marginLeft="18dp"
            android:textSize="12dp"
            android:layout_marginTop="5dp"/>
        <EditText
            android:id="@+id/srockEdit"
            android:layout_width="133dp"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:layout_marginLeft="13dp"
            android:background="@color/transp"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/resultButton"
        android:layout_width="350dp"
        android:layout_height="70dp"
        android:background="@drawable/but_log"
        android:text="@string/result"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        android:layout_marginLeft="5dp"/>
    
    <LinearLayout
        android:layout_width="161dp"
        android:layout_height="55dp"
        android:background="@drawable/srock"
        android:orientation="vertical"
        android:layout_marginTop="30dp"
        android:layout_marginLeft="102dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ezh"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="7dp"/>
        <TextView
            android:id="@+id/resultEdit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="7dp"/>
    </LinearLayout>

    

</androidx.appcompat.widget.LinearLayoutCompat>