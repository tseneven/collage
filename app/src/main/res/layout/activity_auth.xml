<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AuthActivity"
    android:background="@drawable/fon3">
    
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:layout_marginTop="120dp"
        android:layout_marginEnd="300dp"
        android:layout_marginStart="300dp"
        android:layout_marginBottom="120dp"
        android:paddingStart="50dp"
        android:paddingEnd="50dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:background="@drawable/restaingle">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:src="@drawable/logo"/>
        
        <EditText
            android:id="@+id/email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textCursorDrawable="@drawable/coursor"
            android:layout_marginTop="10dp"
            android:hint="Email"
            android:textColorHint="@color/lb_grey"
            android:backgroundTint="@drawable/edit"
            android:inputType="textEmailAddress"
            android:textColor="@color/aqua"
            android:textColorHighlight="@color/aqua"
            android:textColorLink="@color/aqua"
            />

        <EditText
            android:id="@+id/password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textCursorDrawable="@drawable/coursor"
            android:layout_marginTop="10dp"
            android:hint="Password"
            android:textColorHint="@color/lb_grey"
            android:backgroundTint="@drawable/edit"
            android:inputType="textPassword"
            android:textColor="@color/aqua"
            android:textColorHighlight="@color/aqua"
            android:textColorLink="@color/aqua"/>

        <Button
            android:id="@+id/login"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="login"
            android:layout_marginTop="30dp"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:text="Sign In"
            android:background="@drawable/bt"
            />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>