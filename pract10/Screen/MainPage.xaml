<Page x:Class="pract10.Screen.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:domain="clr-namespace:pract10.Domain"
      DataContext="{Binding RelativeSource={RelativeSource Self}}"
      mc:Ignorable="d"
      Title="MainPage" d:DesignHeight="450"
      d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <DataGrid DockPanel.Dock="Top"
                  CanUserAddRows="False"
                  AutoGenerateColumns="False"
                  ColumnWidth="Auto"
                  Width="Auto"
                  x:Name="CreditsGrid">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Категория"
                                    Binding="{Binding Category}" />
                <DataGridTextColumn Header="Сумма"
                                    Binding="{Binding Sum}" />
                <DataGridTextColumn Header="Дата"
                                    Binding="{Binding Date}" />
                <DataGridTextColumn Header="Описание"
                                    Binding="{Binding Description}"
                                    Width="*" />
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Column="1" LastChildFill="False">
            <StackPanel DockPanel.Dock="Top">
                <Button Margin="0 10" x:Name="AddSum" Click="AddSum_OnClick">Добавить расход</Button>
                <Button Margin="0 10" x:Name="ExportToCsv" Click="ExportToCsv_OnClick">Экспорт в CSV</Button>
                <Button Margin="0 10" x:Name="ExportToJson" Click="ExportToJson_OnClick">Экспорт в JSON</Button>
                <TextBlock>Поиск по категории</TextBlock>
                <TextBox x:Name="FilterText" TextChanged="FilterText_OnTextChanged" Text="{Binding FilterString}"></TextBox>
            </StackPanel>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding GetSums, Source={x:Static domain:CreditsList.Instance}}"/>
        </DockPanel>
    </Grid>
</Page>