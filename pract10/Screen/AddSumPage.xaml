<Page x:Class="pract10.Screen.AddSumPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:pract10.Screen"
      DataContext="{Binding RelativeSource={RelativeSource Self}}"
      mc:Ignorable="d"
      Title="AddSumPage" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="1" Grid.Column="1">
            <StackPanel>
                <TextBlock>Сумма</TextBlock>
                <TextBox x:Name="SumText" Text="{Binding Credits.Sum}"/>
            </StackPanel>            
            <StackPanel>
                <TextBlock>Категория</TextBlock>
                <TextBox x:Name="CategoryText" Text="{Binding Credits.Category}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock>Дата</TextBlock>
                <DatePicker x:Name="DatePicker" SelectedDate="{Binding Credits.Date}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock>Описание</TextBlock>
                <TextBox x:Name="DescriptionText"  Text="{Binding Credits.Description}"/>
            </StackPanel>
            <Button Margin="0 10" x:Name="Add" Click="Add_OnClick">Добавить расход</Button>
        </StackPanel>
    </Grid>
</Page>
